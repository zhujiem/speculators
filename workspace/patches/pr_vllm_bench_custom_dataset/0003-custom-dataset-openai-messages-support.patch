+def _parse_tool_call(tool_call: dict) -> dict:
+    """Copy a tool call, parsing JSON-string arguments to a dict."""
+    tc = dict(tool_call)
+    fn = tc.get("function")
+    if isinstance(fn, dict):
+        fn = dict(fn)
+        if isinstance(fn.get("arguments"), str):
+            try:
+                fn["arguments"] = json.loads(fn["arguments"])
+            except Exception:
+                pass
+        tc["function"] = fn
+    return tc
+
